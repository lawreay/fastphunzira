{
  "name": "lawreay/fastphunzira",
  "description": "FastPhunzira learning, exam, and certification platform foundation",
  "type": "project",
  "require": {
    "php": ">=8.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml",
    "check": "php -l public/index.php && php -l bootstrap/app.php"
  }
}
